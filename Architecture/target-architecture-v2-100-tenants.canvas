{
	"nodes":[
		{"id":"grp-data","type":"group","x":100,"y":440,"width":2000,"height":340,"label":"Data — PostgreSQL, ONE database per tenant, sharded across instances"},
		{"id":"grp-core","type":"group","x":100,"y":-400,"width":2000,"height":320,"label":"Core business services — ONE container per module, serving ALL tenants"},
		{"id":"grp-cp","type":"group","x":100,"y":-700,"width":2000,"height":260,"label":"Identity & control plane — shared across ALL tenants, never per-tenant"},
