		{"id":"p-job","type":"text","text":"### Scheduler / Jobs\nJobRunr","x":1230,"y":55,"width":300,"height":100,"color":"6"},
		{"id":"p-mon","type":"text","text":"### All-temple ops questions\nanswered from **logs and metrics**, never SQL","x":1560,"y":55,"width":490,"height":100,"color":"3"},
