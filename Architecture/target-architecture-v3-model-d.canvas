		{"id":"a-idem","type":"text","text":"**Idempotent consumers**\n+ idempotency keys on money calls","x":1300,"y":185,"width":340,"height":100},
		{"id":"a-dlq","type":"text","text":"**Retries · DLQ · replay**\na vendor outage never loses a receipt","x":1680,"y":185,"width":370,"height":100},
