		{"id":"pgb","type":"text","text":"## PgBouncer\n**transaction pooling** from day one\n\nForces `SET LOCAL search_path`\ninside the transaction —\nnever a session-level `SET`","x":160,"y":450,"width":280,"height":200,"color":"1"},
		{"id":"sh-noida","type":"text","text":"### shard-noida — **SILO**\nNoida alone","x":480,"y":450,"width":300,"height":150,"color":"2"},
		{"id":"sh-pool","type":"text","text":"### shard-pool-1 — **POOL**\nGNW · NEX · WHF","x":480,"y":630,"width":300,"height":150,"color":"2"},
